# Cloud PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@your-db-host:5432/admin_saas?schema=public"

# Better-Auth secrets — must be a long random string
BETTER_AUTH_SECRET=replace_with_a_long_random_string
BETTER_AUTH_URL=https://your-admin-saas-domain.com

# IMPORTANT: Must be identical to JWT_SECRET in main-local/.env
# App A signs license JWTs with this secret; App B verifies them with this same secret
JWT_SECRET=replace_with_a_long_random_string

# Public URL of this Next.js app (used by the auth client on the frontend)
NEXT_PUBLIC_APP_URL=https://your-admin-saas-domain.com

# Ed25519 private key used to sign license JWTs (base64 PKCS8 DER).
# Generate a pair with: node scripts/gen-license-keys.js
# SECRET — never commit the real value. Its public half goes in main-local.
LICENSE_PRIVATE_KEY=
