datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------------------------
// BETTER AUTH CORE TABLES
// ----------------------------------------------------------------------
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  role          String?   // "SUPER_ADMIN", "SALES_AGENT", "SUPPORT_AGENT"
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

// ----------------------------------------------------------------------
// SAAS BUSINESS LOGIC TABLES
// ----------------------------------------------------------------------

model Tenant {
  id           String    @id @default(uuid())
  ownerName    String
  companyName  String
  contactEmail String    @unique
  createdAt    DateTime  @default(now())
  licenses     License[]
}

/// One machine running one licence.
///
/// A licence used to bind to a single `macAddress` column that activation
/// simply overwrote, so nothing counted how many machines were actually using
/// it — one licence ran on as many as you liked. Each machine now gets a row,
/// and `maxBranches` is enforced against how many are still in use.
///
/// The identifier is a hash the branch server derives from the platform's own
/// machine identity. It is supplied by software on the customer's machine, so
/// it is not proof of anything against somebody determined; what it stops is
/// casually copying an installation onto a second machine, and it shows the
/// seller how many machines a licence is really running on.
model LicenseInstall {
  id          String    @id @default(uuid())
  licenseId   String
  license     License   @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  /// Hashed machine identity as reported by the branch server.
  hardwareId  String
  /// Optional note from the dashboard — "Front counter PC", "Warehouse".
  label       String?
  branchName  String?
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  lastSeenIp  String?
  /// Set when the seat is handed back — a machine replaced or decommissioned.
  /// A released row is kept for the history and stops counting against the
  /// limit.
  releasedAt  DateTime?
  releaseNote String?

  @@unique([licenseId, hardwareId])
  @@index([licenseId, releasedAt])
}

model License {
  id                  String    @id @default(uuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id])
  licenseKey          String    @unique // e.g., SHP-XYZ1-ABC2-9988
  status              String    @default("PENDING") // PENDING, ACTIVE, EXPIRED, REVOKED

  // Capacity Limits
  maxBranches         Int       @default(1)
  maxSystemsPerBranch Int       @default(3) // 5 device license, 10 device license, etc.

  // Lifecycle
  branchName          String?           // Set by App B upon activation
  validDurationDays   Int       @default(365) // Pre-set before activation
  activatedAt         DateTime?         // Set when App B activates
  expiresAt           DateTime?         // Calculated as activatedAt + validDurationDays
  createdAt           DateTime  @default(now())

  // Hardware Binding. `macAddress` records the first machine that activated
  // this licence, kept for display; the authoritative list of machines using
  // it is `installs`, which is what the seat limit counts.
  motherboardSerial   String?
  macAddress          String?
  installs            LicenseInstall[]

  // License hardening (Phase 4)
  revokedAt           DateTime?         // Set when admin revokes via dashboard
  revokeReason        String?
  lastRefreshAt       DateTime?         // Last successful /licenses/refresh call
  lastRefreshIp       String?
  gracePeriodDays     Int       @default(30) // Days offline tolerance after JWT expiry
  refreshTokenSeq     Int       @default(0)  // Bumped on revoke/transfer to invalidate
}
